  "error": {
    "message": "[
  {
    "expected": "string",
    "code": "invalid_type",
    "path": [
      "name"
    ],
    "message": "Invalid input: expected string, received undefined"
  }
]",
    "name": "ZodError",
  },
  "success": false,
}
`;

